{
  "name": "loja-plug-and-play",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev -p 3410",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start -p 3410",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-presets.mjs",
    "test:e2e": "playwright test",
    "build:trama": "node scripts/next.mjs build --preset=trama",
    "build:forno": "node scripts/next.mjs build --preset=forno",
    "dev:forno": "node scripts/next.mjs dev -p 3410 --preset=forno",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
